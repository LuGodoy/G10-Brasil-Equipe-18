{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://communitylab/schemas/ativo_gerado.schema.json",
  "title": "AtivoGerado",
  "description": "Conteúdo de marketing gerado pelo LLM (F05), com rastreabilidade até as interações de origem e caminho no OCI Object Storage (F08).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "versao_schema",
    "id_ativo",
    "tipo",
    "texto",
    "interacoes_origem",
    "status_revisao",
    "criado_em"
  ],
  "properties": {
    "versao_schema": {
      "type": "string",
      "const": "1.0"
    },
    "id_ativo": {
      "type": "string",
      "pattern": "^ativo_[0-9]{3,}$"
    },
    "tipo": {
      "type": "string",
      "enum": [
        "testemunho_estruturado",
        "case_sucesso",
        "post_linkedin",
        "resumo_newsletter"
      ]
    },
    "titulo": {
      "type": "string",
      "maxLength": 200
    },
    "texto": {
      "type": "string",
      "minLength": 1
    },
    "interacoes_origem": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "integer", "minimum": 1 },
      "description": "Ids das interações usadas. Todo fato do texto deve ser rastreável a elas."
    },
    "status_revisao": {
      "type": "string",
      "enum": ["pendente", "aprovado", "rejeitado"]
    },
    "revisor": {
      "type": "string",
      "description": "Quem aprovou ou rejeitou (opcional)."
    },
    "observacao_revisor": {
      "type": "string",
      "maxLength": 500
    },
    "modelo_llm": {
      "type": "string",
      "description": "Provedor/modelo usado na geração, para auditoria."
    },
    "criado_em": {
      "type": "string",
      "format": "date-time"
    },
    "oci_object_path": {
      "type": "string",
      "pattern": "^ativos/[0-9]{4}-[0-9]{2}-[0-9]{2}/[A-Za-z0-9_.-]+\\.json$",
      "description": "Caminho do objeto no bucket OCI (preenchido após o upload)."
    },
    "id_avaliacao_cqf": {
      "type": "string",
      "pattern": "^cqf_[0-9]{3,}$",
      "description": "Identificador da avaliação CQF vinculada a este ativo (opcional)."
    }
  }
}
