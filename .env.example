# CommunityLab - Arquivo de configuração de exemplo
# IMPORTANTE: Nunca insira senhas, chaves reais ou credenciais confidenciais neste arquivo!
# Copie este arquivo para .env e preencha com suas configurações locais.

# --- Segurança e Pseudonimização ---
# Sal utilizado para gerar os hashes dos identificadores de membros (membro_######)
SAL_PSEUDONIMIZACAO=seu_segredo_de_sal_aqui

# --- Limites e Configurações de Processamento ---
TAMANHO_MINIMO_TEXTO=10
LIMIAR_CONFIANCA=0.6
MAX_TENTATIVAS_LLM=2
TAMANHO_LOTE=50

# --- Inteligência Artificial (LLM) ---
# Configuração do provedor de LLM utilizado pela orquestração
LLM_PROVIDER=oracle
LLM_MODEL=cohere.command-r-plus
LLM_API_KEY=sua_chave_de_api_aqui
LLM_TEMPERATURE=0.2

# --- Oracle Cloud Infrastructure (OCI) ---
# Configuração para persistência de ativos no OCI Object Storage
OCI_CONFIG_FILE=~/.oci/config
OCI_PROFILE=DEFAULT
OCI_COMPARTMENT_ID=ocid1.compartment.oc1..exemplo
OCI_NAMESPACE=seu_namespace_aqui
OCI_BUCKET_NAME=communitylab-ativos
